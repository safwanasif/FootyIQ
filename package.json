{
  "name": "footyiq",
  "version": "0.1.0",
  "description": "Multi-service soccer analytics platform with custom xG ML model (StatsBomb data). Monorepo housing web frontend, Node/Express API, Python ML pipeline, and shared database layer.",
  "private": true,
  "workspaces": [
    "apps/web",
    "services/api",
    "services/ml",
    "packages/db"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace services/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspace apps/web",
    "check": "npm run lint && npm run build",
    "test": "npm run test --workspace services/api",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
